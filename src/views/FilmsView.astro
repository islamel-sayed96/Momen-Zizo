---
import Base from '../layouts/Base.astro';
import FilmGrid from '../components/FilmGrid.astro';
import { ui, type Lang } from '../i18n/ui';
import { films } from '../data/films';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<Base lang={lang} page="films" title={t.meta.films.title} description={t.meta.films.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title">{t.filmPageTitle}</h1>
      <p>{t.filmPageLede}</p>
    </header>
    <FilmGrid lang={lang} items={films} featured />
  </div>
</Base>
