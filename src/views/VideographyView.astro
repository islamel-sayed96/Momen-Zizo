---
import Base from '../layouts/Base.astro';
import FilmGrid from '../components/FilmGrid.astro';
import { ui, type Lang } from '../i18n/ui';
import { films } from '../data/films';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const items = films.filter((f) => f.type !== 'drone');
---
<Base lang={lang} page="videography" title={t.meta.films.title} description={t.meta.films.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title">{t.filmPageTitle}</h1>
      <p set:html={t.filmPageLede} />
    </header>
    <FilmGrid lang={lang} items={items} featured filters />
    <div class="sec-foot"><a class="btn ghost" href={site.videoFolder} target="_blank" rel="noopener">{t.driveFolder} <span class="arrow">→</span></a></div>
  </div>
</Base>
