---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { ui, asset, type Lang } from '../i18n/ui';
import { site, equipment, software } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<Base lang={lang} page="about" title={t.meta.about.title} description={t.meta.about.description}>
  <div class="wrap">
    <header class="page-head">
      <span class="mono">{t.aboutLede}</span>
      <h1 class="page-title">{lang === 'ar' ? 'مؤمن عبد الهادي' : 'Momen Abd ElHady'}</h1>
    </header>
    <div class="about">
      <figure class="portrait" data-reveal>
        <img src={asset('momen.jpg')} srcset={`${asset('momen-600.jpg')} 600w, ${asset('momen.jpg')} 948w`} sizes="(max-width: 860px) 100vw, 40vw" width="948" height="1180" alt={`${site.fullName}, videographer and photographer`} loading="eager" />
        <figcaption class="mono">{site.fullName} · {t.city}</figcaption>
      </figure>
      <div class="bio">
        {t.bio.map((p) => <p>{p}</p>)}
        <div class="specs">
          <div>
            <h2 class="mono">{t.equipmentTitle}</h2>
            <ul>{equipment.map((e) => <li>{e}</li>)}</ul>
          </div>
          <div>
            <h2 class="mono">{t.softwareTitle}</h2>
            <ul>{software.map((e) => <li>{e}</li>)}</ul>
            <h2 class="mono">{t.languagesTitle}</h2>
            <p>{t.languages}</p>
          </div>
        </div>
        <div class="docs">
          <a class="btn solid" href={site.cv} target="_blank" rel="noopener">{t.cv} <span class="arrow">→</span></a>
          <a class="btn" href={site.portfolioPdf} target="_blank" rel="noopener">{t.portfolioPdf} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>

    <section class="section" aria-labelledby="hist-h">
      <div class="sec-head"><h2 id="hist-h">{t.historyTitle}</h2></div>
      <ol class="timeline">
        {t.history.map((h) => (
          <li data-reveal><span class="yrs">{h.years}</span><span class="role">{h.role}</span><span class="place">{h.place}</span></li>
        ))}
      </ol>
    </section>
  </div>
  <Contact lang={lang} />
</Base>
